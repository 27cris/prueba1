    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ice"
        tools:context=".Interfaz2">

        <LinearLayout
            android:id="@+id/white_container"
            android:layout_width="350dp"
            android:layout_height="800dp"
            android:orientation="vertical"
            android:layout_centerInParent="true"
            android:background="@drawable/layout_border"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@color/white"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/logo_image"
                    android:layout_width="wrap_content"
                    android:layout_height="250dp"
                    android:src="@drawable/fondo"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/app_slogan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="90dp"
                    android:text="@string/pasion"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/cafe"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/create_account_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="130dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/CrearCuenta"
                    android:textColor="@color/cafe"
                    android:textSize="25sp" />
            </FrameLayout>

            <EditText
                android:id="@+id/email_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="@color/black"
                android:layout_marginBottom="12dp"
                android:drawablePadding="9dp"
                android:background="@drawable/edittext_border"
                android:drawableStart="@drawable/a" />

            <EditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/contraseña"
                android:inputType="textPassword"
                android:drawableStart="@drawable/b"
                android:textColor="@color/black"
                android:padding="12dp"
                android:drawablePadding="9dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/edittext_border" />

            <EditText
                android:id="@+id/confirm_password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/confirmar_contraseña"
                android:inputType="textPassword"
                android:textColor="@color/black"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:drawablePadding="9dp"
                android:drawableStart="@drawable/b"
                android:background="@drawable/edittext_border" />

            <Button
                android:id="@+id/create_account_button"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="@string/CrearCuenta"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:textSize="15sp"
                android:backgroundTint="@color/verde"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
